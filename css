* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Inter', sans-serif;
    background: linear-gradient(145deg, #eef2fc 0%, #d9e2f0 100%);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    position: relative;
}

/* Login Container Styles */
.login-container {
    max-width: 480px;
    width: 100%;
    background: rgba(255, 255, 255, 0.96);
    border-radius: 2rem;
    box-shadow: 0 25px 45px -12px rgba(0, 0, 0, 0.25), 0 0 0 1px rgba(156, 180, 215, 0.3);
    overflow: hidden;
    transition: transform 0.2s ease;
}

.login-container:hover {
    transform: translateY(-3px);
}

/* Dashboard Container Styles */
.dashboard-container {
    max-width: 1200px;
    width: 100%;
    background: rgba(255, 255, 255, 0.96);
    border-radius: 2rem;
    box-shadow: 0 25px 45px -12px rgba(0, 0, 0, 0.25);
    overflow: hidden;
    animation: slideIn 0.5s ease-out;
}

@keyframes slideIn {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
}

/* Dashboard Headers with Role Colors */
.dashboard-header {
    padding: 2rem;
    color: white;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
}

.admin-header { background: linear-gradient(135deg, #1a237e 0%, #283593 100%); }
.teacher-header { background: linear-gradient(135deg, #1b5e20 0%, #2e7d32 100%); }
.student-header { background: linear-gradient(135deg, #0d47a1 0%, #1565c0 100%); }

.user-info h2 { font-size: 1.5rem; margin-bottom: 0.3rem; }
.user-info p { opacity: 0.9; font-size: 0.9rem; margin-top: 0.2rem; }

.logout-btn {
    background: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 0.6rem 1.2rem;
    border-radius: 2rem;
    color: white;
    cursor: pointer;
    transition: all 0.2s;
    font-weight: 500;
    font-family: 'Inter', sans-serif;
}

.logout-btn:hover {
    background: rgba(255, 255, 255, 0.3);
    transform: translateY(-2px);
}

/* Dashboard Tabs */
.dashboard-tabs {
    display: flex;
    gap: 0;
    background: #f8fafd;
    border-bottom: 1px solid #e2e8f0;
    overflow-x: auto;
    padding: 0 1rem;
}

.tab-btn {
    padding: 1rem 1.5rem;
    background: none;
    border: none;
    font-size: 0.95rem;
    font-weight: 500;
    color: #64748b;
    cursor: pointer;
    transition: all 0.2s;
    font-family: 'Inter', sans-serif;
    white-space: nowrap;
}

.tab-btn i { margin-right: 0.5rem; }
.tab-btn:hover { color: #0f2b3d; background: #f1f5f9; }
.tab-btn.active { color: #1b6b93; border-bottom: 3px solid #1b6b93; }

.dashboard-content { padding: 2rem; }

/* Stats Grid */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
}

.stat-card {
    background: #f8fafd;
    padding: 1.5rem;
    border-radius: 1rem;
    text-align: center;
    border: 1px solid #e2e8f0;
    transition: all 0.2s;
}

.stat-card:hover { transform: translateY(-5px); box-shadow: 0 8px 20px rgba(0,0,0,0.1); }
.stat-card i { font-size: 2rem; color: #1b6b93; margin-bottom: 0.8rem; }
.stat-card h3 { font-size: 1.8rem; color: #0f2b3d; margin-bottom: 0.3rem; }
.stat-card p { color: #6c8eaa; font-size: 0.85rem; }

/* Welcome Message */
.welcome-message {
    background: linear-gradient(135deg, #ffcd4a20 0%, #ffcd4a10 100%);
    padding: 1rem;
    border-radius: 1rem;
    margin-bottom: 1.5rem;
    border-left: 4px solid #ffcd4a;
}

/* Quick Actions */
.quick-actions, .recent-activity, .announcements {
    background: #f8fafd;
    padding: 1.5rem;
    border-radius: 1rem;
    margin-bottom: 1.5rem;
}

.quick-actions h3, .recent-activity h3, .announcements h3 {
    color: #0f2b3d;
    margin-bottom: 1rem;
}

.action-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
}

.action-btn {
    background: white;
    border: 1px solid #cde0ea;
    padding: 0.7rem 1.2rem;
    border-radius: 2rem;
    color: #1b6b93;
    cursor: pointer;
    transition: all 0.2s;
    font-weight: 500;
    font-family: 'Inter', sans-serif;
}

.action-btn:hover {
    background: #1b6b93;
    color: white;
    border-color: #1b6b93;
    transform: translateY(-2px);
}

/* Activity & Announcement Items */
.activity-item, .announcement-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.8rem;
    background: white;
    border-radius: 0.8rem;
    margin-bottom: 0.8rem;
    transition: all 0.2s;
}

.activity-item:hover, .announcement-item:hover {
    background: #f0f6fa;
    transform: translateX(5px);
}

.activity-item i, .announcement-item i { font-size: 1.2rem; color: #1b6b93; }
.activity-item strong, .announcement-item strong { color: #0f2b3d; display: block; margin-bottom: 0.2rem; }
.activity-item p, .announcement-item p { color: #6c8eaa; font-size: 0.85rem; }

/* Class Schedule */
.class-schedule { display: flex; flex-direction: column; gap: 1rem; }
.schedule-item {
    display: flex;
    gap: 1.5rem;
    padding: 1rem;
    background: #f8fafd;
    border-radius: 1rem;
    align-items: center;
    flex-wrap: wrap;
}
.schedule-time { font-weight: 600; color: #1b6b93; min-width: 150px; }
.schedule-info { flex: 1; }
.schedule-info strong { display: block; color: #0f2b3d; }

/* Tables */
.data-table {
    width: 100%;
    border-collapse: collapse;
    background: white;
    border-radius: 1rem;
    overflow: hidden;
}

.data-table th, .data-table td {
    padding: 1rem;
    text-align: left;
    border-bottom: 1px solid #e2e8f0;
}

.data-table th {
    background: #f8fafd;
    font-weight: 600;
    color: #0f2b3d;
}

.data-table tr:hover { background: #f8fafd; }

/* Badges */
.badge {
    padding: 0.25rem 0.75rem;
    border-radius: 2rem;
    font-size: 0.8rem;
    font-weight: 500;
}

.badge.active { background: #c8e6d9; color: #1e7e34; }
.badge.inactive { background: #ffcdd2; color: #c62828; }
.badge.pending { background: #fff3e0; color: #e65100; }
.badge.in-progress { background: #e3f2fd; color: #1565c0; }

/* Course & Class Grids */
.course-grid, .class-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 1rem;
}

.course-card, .class-card {
    background: #f8fafd;
    padding: 1.5rem;
    border-radius: 1rem;
    text-align: center;
    border: 1px solid #e2e8f0;
}

.course-card i, .class-card i { font-size: 2rem; color: #1b6b93; margin-bottom: 1rem; }
.course-card h4, .class-card h4 { color: #0f2b3d; margin-bottom: 0.5rem; }

/* Progress Bar */
.progress-bar {
    background: #e2e8f0;
    border-radius: 1rem;
    overflow: hidden;
    height: 8px;
    margin: 0.5rem 0;
}
.progress-fill { background: #1b6b93; height: 100%; border-radius: 1rem; }

/* Student List */
.student-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}
.student-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background: #f8fafd;
    border-radius: 1rem;
}
.student-card i { font-size: 2rem; color: #1b6b93; }
.student-card div { flex: 1; }
.student-card strong { display: block; color: #0f2b3d; }

/* Grade Summary */
.grade-summary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
}
.grade-card {
    background: #f8fafd;
    padding: 1rem;
    border-radius: 1rem;
    text-align: center;
}
.grade-letter {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: #1b6b93;
    color: white;
    border-radius: 2rem;
    margin-top: 0.5rem;
    font-weight: 600;
}

/* Attendance */
.attendance-summary {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    align-items: center;
}
.attendance-circle {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    background: linear-gradient(135deg, #1b6b93, #0f2b3d);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 2rem;
    font-weight: bold;
}
.attendance-circle span { font-size: 0.8rem; margin-top: 0.5rem; }
.attendance-details { flex: 1; }
.attendance-month { margin-bottom: 1rem; }
.att-bars { display: flex; gap: 0.5rem; margin-top: 0.3rem; }
.present { background: #4caf50; padding: 0.25rem 0.5rem; border-radius: 0.5rem; color: white; font-size: 0.8rem; }
.absent { background: #f44336; padding: 0.25rem 0.5rem; border-radius: 0.5rem; color: white; font-size: 0.8rem; }

/* Buttons */
.small-btn {
    background: #1b6b93;
    color: white;
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    margin-top: 0.5rem;
}
.small-btn:hover { background: #0f4d6b; }

.create-btn {
    background: #4caf50;
    color: white;
    border: none;
    padding: 0.7rem 1.2rem;
    border-radius: 0.5rem;
    cursor: pointer;
    margin-bottom: 1rem;
}

/* Login Form Styles */
.school-header {
    background: #0f2b3d;
    padding: 2rem 1.8rem 1.5rem;
    text-align: center;
    color: white;
}

.school-icon {
    background: #ffcd4a;
    width: 70px;
    height: 70px;
    border-radius: 35px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1rem;
    box-shadow: 0 8px 18px rgba(0,0,0,0.2);
}

.school-icon i { font-size: 2.4rem; color: #1e3a4d; }
.school-header h1 { font-size: 1.9rem; font-weight: 700; }
.school-header p { font-size: 0.9rem; opacity: 0.85; margin-top: 0.4rem; }

.form-wrapper { padding: 2rem 1.8rem 2.2rem; }

.input-group { margin-bottom: 1.5rem; display: flex; flex-direction: column; }
.input-group label { font-size: 0.85rem; font-weight: 600; color: #2c4b66; margin-bottom: 0.5rem; }

.input-field {
    display: flex;
    align-items: center;
    background: #f8fafd;
    border: 1px solid #cddfe7;
    border-radius: 1rem;
    padding: 0.2rem 0.8rem;
}
.input-field i { color: #6f8faa; width: 2rem; }
.input-field input {
    width: 100%;
    padding: 0.9rem 0.2rem;
    border: none;
    background: transparent;
    font-size: 1rem;
    outline: none;
}
.input-field:focus-within {
    border-color: #1e6f9f;
    box-shadow: 0 0 0 3px rgba(30, 111, 159, 0.2);
}

.options-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 0.8rem 0 1.8rem;
    font-size: 0.85rem;
}

.checkbox { display: flex; align-items: center; gap: 0.5rem; cursor: pointer; }
.forgot-link { color: #1b6b93; text-decoration: none; }

.login-btn {
    background: #0f2b3d;
    width: 100%;
    border: none;
    border-radius: 2rem;
    padding: 0.9rem;
    color: white;
    font-weight: 700;
    font-size: 1.05rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    cursor: pointer;
    transition: all 0.25s;
}

.login-btn:hover { background: #1d445f; transform: scale(0.98); }

.message-area {
    margin-top: 1.5rem;
    background: #f0f6fa;
    border-radius: 0.9rem;
    padding: 0.8rem;
    text-align: center;
    font-size: 0.85rem;
    border-left: 4px solid #1b6b93;
}

.error-message { background: #ffe9e9; border-left-color: #d14545; color: #b13e3e; }
.success-message { background: #e4f4e8; border-left-color: #2a7f49; color: #1a5a38; }

.demo-hint {
    background: #ecf3f8;
    margin: 0 1.8rem 1.5rem;
    padding: 0.6rem 1rem;
    border-radius: 2rem;
    font-size: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
}

footer {
    text-align: center;
    font-size: 0.7rem;
    padding: 1rem;
    color: #6f8eaa;
    border-top: 1px solid #dee9f0;
}

/* Notification Toast */
.notification-toast {
    position: fixed;
    bottom: 20px;
    right: 20px;
    background: #0f2b3d;
    color: white;
    padding: 1rem 1.5rem;
    border-radius: 0.8rem;
    box-shadow: 0 10px 25px rgba(0,0,0,0.2);
    display: flex;
    align-items: center;
    gap: 0.8rem;
    z-index: 1000;
    animation: slideInRight 0.3s ease-out;
}

@keyframes slideInRight {
    from { transform: translateX(100%); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
}

@media (max-width: 768px) {
    .dashboard-tabs { overflow-x: auto; }
    .stats-grid { grid-template-columns: 1fr; }
    .action-buttons { flex-direction: column; }
    .dashboard-header { flex-direction: column; text-align: center; }
    .attendance-summary { flex-direction: column; }
}
